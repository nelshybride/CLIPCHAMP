[{"start": 0.0, "end": 4.48, "text": "We're here. We're here. We're here. We're calling."}, {"start": 4.48, "end": 7.28, "text": "She's walking out of the lift. You don't know what to do with this."}, {"start": 7.28, "end": 10.08, "text": "Oh, that's a good point. She has a baby."}, {"start": 10.08, "end": 10.88, "text": "Yes, she has a baby."}, {"start": 10.88, "end": 12.08, "text": "What?"}, {"start": 12.08, "end": 15.44, "text": "Are you going to be able to take away the most women in the decade?"}, {"start": 15.44, "end": 16.88, "text": "Oh, and more women."}, {"start": 16.88, "end": 19.6, "text": "I call out there. There's someone they can."}, {"start": 19.6, "end": 20.88, "text": "The meantime is time."}, {"start": 20.88, "end": 22.56, "text": "Just hold tight."}, {"start": 22.56, "end": 23.52, "text": "What?"}, {"start": 23.52, "end": 24.24, "text": "I don't know."}, {"start": 24.24, "end": 24.4, "text": "I don't know."}, {"start": 24.4, "end": 25.36, "text": "Do I?"}, {"start": 25.36, "end": 25.76, "text": "Do I?"}, {"start": 25.76, "end": 29.76, "text": "I know you and I know nothing is for you to free up."}]